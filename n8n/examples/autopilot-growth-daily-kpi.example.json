{
  "name": "CrowdRelay — Autopilot daily Spotify + Bandsintown KPI digest",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 24}]}},
      "id": "k5000000-0000-4000-8000-000000000001",
      "name": "Daily growth tick",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.spotify.com/v1/artists/' + $env.SPOTIFY_ARTIST_ID }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.SPOTIFY_ACCESS_TOKEN }}"}]},
        "options": {"timeout": 10000}
      },
      "id": "k5000000-0000-4000-8000-000000000002",
      "name": "Read Spotify KPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, -180]
    },
    {
      "parameters": {
        "url": "={{ 'https://rest.bandsintown.com/artists/' + encodeURIComponent($env.BANDSINTOWN_ARTIST_NAME) }}",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "app_id", "value": "={{ $env.BANDSINTOWN_APP_ID }}"}]},
        "options": {"timeout": 10000}
      },
      "id": "k5000000-0000-4000-8000-000000000003",
      "name": "Read Bandsintown KPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.CROWDRELAY_ADMIN_BASE_URL + '/v1/admin/autopilot/overview' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $env.CROWDRELAY_ADMIN_TOKEN }}"}]},
        "options": {"timeout": 10000}
      },
      "id": "k5000000-0000-4000-8000-000000000004",
      "name": "Read Autopilot overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 180]
    },
    {
      "parameters": {
        "jsCode": "const spotify=$('Read Spotify KPI').first().json; const bandsintown=$('Read Bandsintown KPI').first().json; const autopilot=$('Read Autopilot overview').first().json; const spotifyFollowers=spotify?.followers?.total??null; const bandsintownFollowers=bandsintown?.followers_count??bandsintown?.followers?.total??null; const lines=[`VIRYA growth · ${new Date().toISOString().slice(0,10)}`,'',`Spotify followers: ${spotifyFollowers??'n/a'}`,`Bandsintown followers: ${bandsintownFollowers??'n/a'}`,`Autopilot runtime: ${autopilot?.runtime_enabled?'enabled':'disabled'}`,`Autopilot actions today: ${autopilot?.actions_24h??autopilot?.action_count_24h??'n/a'}`,`Needs attention: ${autopilot?.needs_attention??autopilot?.attention_count??'n/a'}`,'',`Spotify: ${$env.VIRYA_SPOTIFY_URL||('https://open.spotify.com/artist/'+$env.SPOTIFY_ARTIST_ID)}`,`Bandsintown: ${$env.BANDSINTOWN_ARTIST_URL||'configured in provider'}`]; return [{json:{subject:`VIRYA daily growth · Spotify ${spotifyFollowers??'n/a'} · Bandsintown ${bandsintownFollowers??'n/a'}`,body:lines.join('\\n')}}];"
      },
      "id": "k5000000-0000-4000-8000-000000000005",
      "name": "Build daily growth digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.VIRYA_AUTOPILOT_DIGEST_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {"appendAttribution": false}
      },
      "id": "k5000000-0000-4000-8000-000000000006",
      "name": "Send daily digest",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [820, 0]
    }
  ],
  "connections": {
    "Daily growth tick": {"main": [[{"node":"Read Spotify KPI","type":"main","index":0},{"node":"Read Bandsintown KPI","type":"main","index":0},{"node":"Read Autopilot overview","type":"main","index":0}]]},
    "Read Spotify KPI": {"main": [[{"node":"Build daily growth digest","type":"main","index":0}]]},
    "Read Bandsintown KPI": {"main": [[{"node":"Build daily growth digest","type":"main","index":0}]]},
    "Read Autopilot overview": {"main": [[{"node":"Build daily growth digest","type":"main","index":0}]]},
    "Build daily growth digest": {"main": [[{"node":"Send daily digest","type":"main","index":0}]]}
  },
  "active": false,
  "settings": {"executionOrder":"v1","saveDataErrorExecution":"none","saveDataSuccessExecution":"none","saveManualExecutions":false},
  "tags": []
}
