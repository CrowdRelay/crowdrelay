    {"parameters":{"jsCode":"const now=Date.now(); const templates=new Set(['show.growth.free_fan_push.v1','autopilot.spotify.follow.v1','autopilot.bandsintown.follow.v1']); const rows=$input.all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]); return rows.filter(c=>c&&c.status==='scheduled'&&templates.has(c.template_key)&&c.scheduled_at&&new Date(c.scheduled_at).getTime()<=now+60000).map(c=>({json:c}));"},"id":"g4000000-0000-4000-8000-000000000003","name":"Keep due growth campaigns","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,0]},
    {"parameters":{"method":"GET","url":"={{ $env.CROWDRELAY_INTERNAL_BASE_URL + '/v1/internal/communications/campaigns/' + $json.id + '/delivery-plan' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"={{ 'Bearer ' + $env.CROWDRELAY_COMMERCE_TOKEN }}"}]},"sendQuery":true,"queryParameters":{"parameters":[{"name":"limit","value":"250"}]},"options":{"timeout":15000}},"id":"g4000000-0000-4000-8000-000000000004","name":"Load consented delivery page","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[720,0]},
