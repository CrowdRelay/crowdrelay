    {"parameters":{"jsCode":"const r=$('Build growth email').item.json; const failed=Boolean($json.error); const ref=$json.message_id||$json.id||$json.provider_reference||null; return [{json:{campaign_id:r.campaign_id,fan_id:r.fan_id,attempt_key:r.attempt_key,status:failed?'failed':'delivered',provider_reference:failed?null:(ref?String(ref):null),error_code:failed?'mail_delivery_failed':null}}];"},"id":"g4000000-0000-4000-8000-000000000010","name":"Build delivery result","type":"n8n-nodes-base.code","typeVersion":2,"position":[2160,-120]},
