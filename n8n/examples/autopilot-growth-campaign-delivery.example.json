    {"parameters":{"jsCode":"const r=$('Expand consented recipients').item.json; const c=r.content||{}; const resolve=v=>{if(!v)return ''; const s=String(v); return s.startsWith('env:')?String($env[s.slice(4)]||''):s}; const spotify=resolve(c.growth_ctas?.spotify_artist_url||c.spotify_url||c.spotify_artist_url); const bands=resolve(c.growth_ctas?.bandsintown_follow_url||c.bandsintown_artist_url||c.bandsintown_url); const playlist=resolve(c.growth_ctas?.spotify_playlist_url||c.spotify_playlist_url); const lines=[]; if(spotify) lines.push('Spotify: '+spotify); if(bands) lines.push('Bandsintown: '+bands); if(playlist) lines.push('Playlista: '+playlist); if(c.ticket_url) lines.push('Koncert: '+c.ticket_url); const cta=c.cta||'Jeśli lubisz naszą muzykę, obserwuj nas i wróć na kolejny koncert.'; const first=r.display_name?`Cześć ${r.display_name}!`:'Cześć!'; const body=[first,'',cta,'',...lines,'','Dzięki za wsparcie!','VIRYA'].join('\\n'); return [{json:{...r,attempt_key:'n8n:growth:'+r.campaign_id+':'+r.fan_id,subject:r.subject||('VIRYA — '+r.campaign_name),body}}];"},"id":"g4000000-0000-4000-8000-000000000008","name":"Build growth email","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,-120]},
