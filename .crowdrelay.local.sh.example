# shellcheck shell=bash
# Copy to .crowdrelay.local.sh. This file is sourced by ./crowdrelayctl and is ignored by Git.

CROWDRELAY_IMAGE_SHA="REPLACE_WITH_FULL_40_CHARACTER_COMMIT_SHA"
CROWDRELAY_COMPOSE_FILE="compose.production.yaml"
CROWDRELAY_ENV_FILE="deploy/.env.production"
CROWDRELAY_BOOTSTRAP_FILE="deploy/bootstrap.production.json"
CROWDRELAY_WEBHOOK_SECRETS_FILE="deploy/webhook-secrets.production.json"
CROWDRELAY_DOCKER_NETWORK="crowdrelay"
CROWDRELAY_CREATE_NETWORK="false"
CROWDRELAY_PUBLIC_BASE_URL="https://api.example.com"
CROWDRELAY_BACKUP_BEFORE_DEPLOY="false"
CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS="180"

# Optional remote deployment.
CROWDRELAY_SSH_TARGET="deploy@example.com"
CROWDRELAY_REMOTE_INSTALL_DIR="/srv/crowdrelay"
CROWDRELAY_REMOTE_ARCHIVE="/tmp/crowdrelay-deploy.tar.gz"

# Optional integration hooks. Define only what your infrastructure needs.
# crowdrelay_before_deploy() { :; }
# crowdrelay_after_deploy() { :; }
# crowdrelay_after_verify() { :; }
# crowdrelay_backup() { pg_dump --format=custom "$DATABASE_URL" > "backup.dump"; }
# crowdrelay_notify() { printf '%s\n' "$1"; }
