# Non-secret runtime configuration for the isolated Rekor proof anchor.
# `crowdrelay-api-active` is the alias that follows the live colour — see
# ACTIVE_ALIAS in scripts/deploy-bluegreen.sh, and the same name in
# deploy/area-management.Caddyfile. The plain `crowdrelay-api` alias only
# exists in compose.production.yaml; compose.bluegreen.yaml publishes
# [crowdrelay-api-green, crowdrelay-api-active], so pointing here at
# `crowdrelay-api` stops resolving the moment a blue-green deploy happens.
CROWDRELAY_INTERNAL_URL=http://crowdrelay-api-active:8080
REKOR_URL=https://rekor.sigstore.dev
ANCHOR_WORKER_ID=virya-rekor-anchor-01
ANCHOR_POLL_MS=5000
DEPENDENCY_PROBE_MS=30000
ANCHOR_LEASE_SECONDS=300
ANCHOR_CLAIM_LIMIT=8
REQUEST_TIMEOUT_MS=15000
MAX_JSON_RESPONSE_BYTES=524288
MAX_TEXT_RESPONSE_BYTES=262144
PORT=8081
