[Unit]
Description=Virya ecosystem production smoke
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/virya/production-smoke.env
StateDirectory=crowdrelay-production-smoke
Environment=SMOKE_STATE_DIR=/var/lib/crowdrelay-production-smoke
ExecStart=/opt/crowdrelay/scripts/production-smoke.sh
User=ubuntu
Group=ubuntu
NoNewPrivileges=true
PrivateTmp=true
