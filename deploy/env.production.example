# Copy this to `deploy/.env.production` on the host. That exact path is what
# `env_file:` injects into the api and worker containers -- it is the file the
# services read.
#
# It is NOT `/opt/crowdrelay/.env`. Compose reads that one to substitute
# `${VAR}` in the compose files, so a variable written only there reaches a
# container solely if some compose file names it. Put a value in the wrong file
# and it looks configured, survives restarts and deploys, and is consumed by
# nothing: that is how city geocoding stayed switched off with the contact
# address correctly set. `crowdrelayctl doctor` now fails on that mismatch and
# names the variable to move.

CROWDRELAY_ENV=production
CROWDRELAY_BIND_ADDR=0.0.0.0:8080
CROWDRELAY_DATABASE_URL=postgres://crowdrelay:REPLACE_DATABASE_PASSWORD@postgres:5432/crowdrelay

# Postgres container initialization (required by the postgres service in
# compose.production.yaml). POSTGRES_USER/DB must match the user/db in
# CROWDRELAY_DATABASE_URL above. The password must also match.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_DB=postgres
# Eight, because that is what production runs (`crowdrelay_db_pool_max` on
# /metrics reads 8). This file said 5, which nothing deployed used — and a host
# provisioned from it would get a pool of five while the operations page fires
# nine endpoints at once. The control plane's reads share one process-wide
# budget of three quarters of this pool (see `ControlPlaneReadBudget` in
# crowdrelay-api/src/ops/fan_out.rs), so the smaller pool would not starve the
# API, but it would serialise the page harder than production does. Keep this
# number equal to what production runs, or the example teaches a different
# shape from the deployment.
CROWDRELAY_DATABASE_MAX_CONNECTIONS=8
# Worker-only override — the worker runs eight PgListener loops that each pin
# a pool connection for the process lifetime, so its pool must exceed the
# listener count or every real query starves (observed 2026-09-23). The
# compose files default this to 16; set it here only to change that.
# CROWDRELAY_WORKER_DATABASE_MAX_CONNECTIONS=16
CROWDRELAY_DATABASE_CONNECT_TIMEOUT_MS=5000
CROWDRELAY_DATABASE_PING_TIMEOUT_MS=2000
CROWDRELAY_DATABASE_OPERATION_TIMEOUT_MS=5000
CROWDRELAY_DATABASE_LOCK_TIMEOUT_MS=1000
CROWDRELAY_RESPONSE_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
CROWDRELAY_PREVIOUS_RESPONSE_ENCRYPTION_SECRET=
CROWDRELAY_ALLOWED_ORIGINS=https://virya.music,https://www.virya.music,https://synesthesia.virya.music
CROWDRELAY_WORKSPACE_SLUG=virya
CROWDRELAY_PUBLIC_SITE_BASE_URL=https://virya.music
# The API's own public origin — the host /v1/public/approvals/{token}
# answers on; crew e-mail one-click links mint against it.
CROWDRELAY_PUBLIC_API_ORIGIN=https://signal-api.virya.music
CROWDRELAY_DEFAULT_COUNTRY_CODE=PL
CROWDRELAY_TENANT_REGION=eu
CROWDRELAY_TENANT_LOCALE=pl-PL
CROWDRELAY_TENANT_TIMEZONE=Europe/Warsaw
CROWDRELAY_TENANT_CURRENCY=PLN
CROWDRELAY_TENANT_DATE_FORMAT=dmy
CROWDRELAY_TENANT_NUMBER_FORMAT=comma_decimal
CROWDRELAY_TENANT_DATA_REGION=eu
# Bandsintown for Artists issues an artist-scoped API key. Keep the production
# credential in deployment environment rather than event_sources.app_id.
CROWDRELAY_BANDSINTOWN_API_KEY=REPLACE_BANDSINTOWN_API_KEY
CROWDRELAY_REDIRECT_REFRESH_INTERVAL_MS=15000
CROWDRELAY_CLICK_CHANNEL_CAPACITY=2048
CROWDRELAY_CLICK_BATCH_SIZE=100
CROWDRELAY_CLICK_FLUSH_INTERVAL_MS=500
CROWDRELAY_EVENT_REMINDER_OFFSETS_MINUTES=1440,120
CROWDRELAY_EVENT_REMINDER_POLL_INTERVAL_MS=60000
CROWDRELAY_AUTOPILOT_ENABLED=false
CROWDRELAY_AUTOPILOT_POLL_INTERVAL_MS=60000
CROWDRELAY_COMMERCE_API_KEY=REPLACE_COMMERCE_API_KEY
CROWDRELAY_ADMIN_API_KEY=REPLACE_ADMIN_API_KEY
CROWDRELAY_STAFF_API_KEY=REPLACE_STAFF_API_KEY
CROWDRELAY_QR_SIGNING_SECRET=REPLACE_QR_SIGNING_SECRET
CROWDRELAY_ADMIN_MEMBER_EMAIL=admin@example.com
CROWDRELAY_STAFF_MEMBER_EMAIL=staff@example.com
CROWDRELAY_QR_TTL_SECONDS=30
CROWDRELAY_REQUIRE_DOUBLE_OPT_IN=true
CROWDRELAY_RANDOM_DRAWS_ENABLED=false
CROWDRELAY_BOOTSTRAP_FILE=/run/crowdrelay/bootstrap.json
CROWDRELAY_WEBHOOK_SECRETS_FILE=/run/secrets/crowdrelay-webhooks.json

# Push delivery: FCM (Android) + Web Push (browser). The service account
# JSON is mounted by compose.production.yaml at /run/secrets/.
CROWDRELAY_PUSH_DELIVERY_ENABLED=true
CROWDRELAY_FCM_PROJECT_ID=virya-signal
CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# Override the host-side path to the FCM service account JSON if it differs
# from the compose default (./secrets/virya-signal-firebase-service-account.json).
# When using docker-compose.yml (which mounts ./secrets/ -> /run/secrets/),
# set CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/virya-signal-firebase-service-account.json
# instead, since the file name in the secrets directory is not renamed.
CROWDRELAY_FCM_SERVICE_ACCOUNT_HOST_FILE=./secrets/virya-signal-firebase-service-account.json
CROWDRELAY_WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_VAPID_PUBLIC_KEY
CROWDRELAY_WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_VAPID_PRIVATE_KEY
CROWDRELAY_WEB_PUSH_SUBJECT=mailto:operator@virya.music

# City geocoding: gives fan-requested cities the coordinates the nearby-show
# loop needs. Without a contact address the worker refuses to start, because
# the public geocoder's usage policy makes an identifying User-Agent a
# condition of access -- and a requested city with no coordinates reaches
# nobody, whatever their consent says. Point the base URL at a self-hosted or
# paid instance to leave the public one.
CROWDRELAY_CITY_GEOCODING_CONTACT=operator@virya.music
CROWDRELAY_CITY_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# YouTube Data API v3 key (server-side, IP-restricted). Used by the growth
# metric sync worker to fetch channel subscriber counts. No OAuth needed.
CROWDRELAY_YOUTUBE_API_KEY=REPLACE_YOUTUBE_API_KEY

# Spotify — no credentials needed. Uses internal partner API.
# Facebook Graph API Page access token for follower count sync AND for
# publishing social posts to the band's Page — one Page-scoped token serves
# both. Must be the page token derived from a system user (/me/accounts),
# not the system-user or user token itself.
CROWDRELAY_FACEBOOK_PAGE_ACCESS_TOKEN=REPLACE_FACEBOOK_PAGE_ACCESS_TOKEN

# Publishing kill switches — the deployment-level gates for anything that
# writes to an outside channel. All default to off; each must be true for
# its channel to auto-publish, on top of the tenant's own settings:
#   CROWDRELAY_SOCIAL_AUTO_POST    — hard gate for Facebook/Instagram/X posts
#                                    (the tenant's social_auto_post setting
#                                    toggles live; this flag still wins)
#   CROWDRELAY_TELEGRAM_AUTO_POST  — Telegram channel posts via the Bot API
#   CROWDRELAY_DISCORD_AUTO_POST   — Discord posts (no executor yet)
#   CROWDRELAY_COMMUNITY_AUTO_POST — Reddit/community relays via agents service
#   CROWDRELAY_REDDIT_WRITE_ENABLED — required on top of COMMUNITY_AUTO_POST
#                                    for Reddit writes specifically
CROWDRELAY_SOCIAL_AUTO_POST=false
CROWDRELAY_TELEGRAM_AUTO_POST=false
CROWDRELAY_DISCORD_AUTO_POST=false
CROWDRELAY_COMMUNITY_AUTO_POST=false
CROWDRELAY_REDDIT_WRITE_ENABLED=false
# Unattended replies to comments on the band's Reddit posts (see .env.example).
CROWDRELAY_REDDIT_AUTO_REPLY=false

# TikTok Display API credentials for follower count sync.
CROWDRELAY_TIKTOK_CLIENT_KEY=REPLACE_TIKTOK_CLIENT_KEY
CROWDRELAY_TIKTOK_CLIENT_SECRET=REPLACE_TIKTOK_CLIENT_SECRET

# OSM/Overpass venue sweep (§12-3): mints shared place_venues rows and
# ODbL-licensed open_directory facts for cities where any tenant has fans
# or a show. OFF until the sweep's output has been verified in production —
# it writes the shared registry every tenant reads.
CROWDRELAY_OSM_VENUE_SWEEP_ENABLED=false
# Optional Overpass mirror or self-hosted endpoint; unset means the public
# overpass-api.de interpreter.
# CROWDRELAY_OSM_OVERPASS_URL=https://overpass.example/api/interpreter

# Ticketmaster Discovery sweep (§12-3): writes event_evidence facts,
# (ticketmaster, venue-id) anchors and peer acts for cities the OSM sweep
# also visits — only onto rooms the registry already holds; it mints no
# venue. OFF by default and inert without the API key.
CROWDRELAY_TICKETMASTER_ENABLED=false
# CROWDRELAY_TICKETMASTER_API_KEY=REPLACE_TICKETMASTER_API_KEY
# Optional endpoint override; unset means app.ticketmaster.com/discovery/v2.
# CROWDRELAY_TICKETMASTER_EVENTS_URL=https://app.ticketmaster.com/discovery/v2/events.json

# GitHub registry mirror: a workbook (database.xlsx) in a repo the operator
# edits — tabs for venues, peer bands and booking agents — imported daily at
# 12:00 Europe/Warsaw through the same sheet intake the Drive scan uses.
# Unset = the source stays dark. PATH is a directory inside the repo
# (default: root), REF a branch (default: main); TOKEN only while the repo
# is private — a PAT with contents:read on that repo is enough.
# CROWDRELAY_GITHUB_REGISTRY_REPO=owner/repo
# CROWDRELAY_GITHUB_REGISTRY_PATH=
# CROWDRELAY_GITHUB_REGISTRY_REF=main
# CROWDRELAY_GITHUB_REGISTRY_TOKEN=REPLACE_GITHUB_TOKEN

RUST_LOG=info,crowdrelay=info

CROWDRELAY_API_IMAGE=ghcr.io/crowdrelay/crowdrelay-api
CROWDRELAY_WORKER_IMAGE=ghcr.io/crowdrelay/crowdrelay-worker
# Sizing note (measured): the API saturates a 0.5-CPU quota near ~80 rps and
# doubles that at 1.0 CPU; the handler itself is far cheaper than the quota.
# Raise CROWDRELAY_API_CPUS before scaling replicas when p95 climbs while the
# pool stays idle. Worker delivery cadence (250ms poll, batch 100) is already
# matched to n8n/virya consumer behavior — tune only with production data.
# API memory is sized for the retained footprint, not startup: glibc arena
# retention ratchets RSS to ~240MiB after sustained traffic (measured on
# prod). 256m left no burst headroom — the cgroup OOM-killed the API 730
# times in 7 days. 512m doubled the settled ceiling; MALLOC_ARENA_MAX
# (compose default 2) caps the retention itself. 2026-09-23: the settled
# footprint had climbed to ~490MiB and 512m was OOM-killing the API hourly
# (17 kills in 17h, RSS 520-522MB at each kill, only health/proofs-claim
# polling on the wire). 1024m stops the kills; the climb itself is an open
# investigation — a 4x-over-measured retained footprint is not arena
# behaviour alone.
CROWDRELAY_API_MEMORY=1024m
CROWDRELAY_API_CPUS=0.50
CROWDRELAY_API_TOKIO_THREADS=2
CROWDRELAY_WORKER_MEMORY=256m
CROWDRELAY_WORKER_CPUS=0.50
CROWDRELAY_WORKER_TOKIO_THREADS=1
CROWDRELAY_SETUP_TOKIO_THREADS=1

# Team-routing contacts. The elastic form is a JSON array of member objects;
# the control plane provisioner renders it from the onboarding roster.
# Skills come from the domain TeamSkill vocabulary (general, operations,
# booking, approval, technical, visual, video, photography, social,
# english_copy, polish_copy, people). `key` is optional — positional
# `member_N` keys are assigned when omitted, but reordering the array then
# re-keys that member, so provisioned rosters carry explicit keys.
# CROWDRELAY_TEAM_MEMBERS_JSON=[{"key":"ops_lead","name":"Ada","email":"ada@example.test","skills":["operations","booking"]}]
# Legacy slot form — still honored, and still fine for the five-member Virya
# deployment. A JSON entry wins when its key collides with a member_N slot.
# Set as deploy secrets/env; never commit real addresses.
VIRYA_TEAM_MEMBER_1_EMAIL=
VIRYA_TEAM_MEMBER_2_EMAIL=
VIRYA_TEAM_MEMBER_3_EMAIL=
VIRYA_TEAM_MEMBER_4_EMAIL=
VIRYA_TEAM_MEMBER_5_EMAIL=

# Required only when CROWDRELAY_AREA_MANAGEMENT_ENABLED=true.
# Bind the AREA proxy only to a private management interface, never 0.0.0.0.
# CROWDRELAY_AREA_MANAGEMENT_BIND_IP=127.0.0.1
