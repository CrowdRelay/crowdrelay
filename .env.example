# Local Docker Compose defaults only. Do not deploy these credentials unchanged.
CROWDRELAY_ENV=development
CROWDRELAY_BIND_ADDR=0.0.0.0:8080
POSTGRES_DB=crowdrelay
POSTGRES_USER=crowdrelay
POSTGRES_PASSWORD=crowdrelay-local-only
CROWDRELAY_POSTGRES_PORT=5432
CROWDRELAY_DATABASE_URL=postgres://crowdrelay:crowdrelay-local-only@postgres:5432/crowdrelay
CROWDRELAY_DATABASE_MAX_CONNECTIONS=10
CROWDRELAY_DATABASE_CONNECT_TIMEOUT_MS=5000
CROWDRELAY_DATABASE_PING_TIMEOUT_MS=2000
CROWDRELAY_DATABASE_OPERATION_TIMEOUT_MS=5000
CROWDRELAY_DATABASE_LOCK_TIMEOUT_MS=1000
# Local-only deterministic secret. Generate at least 32 random bytes for any deployment.
CROWDRELAY_RESPONSE_ENCRYPTION_SECRET=crowdrelay-local-response-encryption-only
CROWDRELAY_PREVIOUS_RESPONSE_ENCRYPTION_SECRET=
CROWDRELAY_ALLOWED_ORIGINS=http://localhost:4321
CROWDRELAY_WORKSPACE_SLUG=example
CROWDRELAY_PUBLIC_SITE_BASE_URL=http://localhost:4321
CROWDRELAY_DEFAULT_COUNTRY_CODE=PL
CROWDRELAY_TENANT_REGION=eu
CROWDRELAY_TENANT_LOCALE=pl-PL
CROWDRELAY_TENANT_TIMEZONE=Europe/Warsaw
CROWDRELAY_TENANT_CURRENCY=PLN
CROWDRELAY_TENANT_DATE_FORMAT=dmy
CROWDRELAY_TENANT_NUMBER_FORMAT=comma_decimal
CROWDRELAY_TENANT_DATA_REGION=eu
# Bandsintown for Artists issues an artist-scoped API key. Keep the production
# credential in the deployment environment rather than bootstrap/database state.
CROWDRELAY_BANDSINTOWN_API_KEY=
CROWDRELAY_REDIRECT_REFRESH_INTERVAL_MS=30000
CROWDRELAY_BOOTSTRAP_JSON='{"workspace_name":"CrowdRelay Local","cities":[{"slug":"wroclaw","name":"Wrocław","country":"PL","region":"Dolnośląskie","lat":51.1079,"lng":17.0385},{"slug":"warszawa","name":"Warszawa","country":"PL","region":"Mazowieckie","lat":52.2297,"lng":21.0122},{"slug":"krakow","name":"Kraków","country":"PL","region":"Małopolskie","lat":50.0647,"lng":19.945}],"campaigns":[{"name":"Local launch","active":true,"smart_links":[{"slug":"local-launch","destination_url":"http://localhost:4321/join","active":true}]}],"webhook_endpoints":[]}'

# Production webhook secrets are read from a mounted JSON file whose keys are
# `signing_secret_ref` values and whose values contain at least 32 random bytes.
# Do not commit that file. Leave this unset while no webhook endpoint is active.
# CROWDRELAY_WEBHOOK_SECRETS_FILE=/run/secrets/crowdrelay-webhooks.json

CROWDRELAY_CLICK_CHANNEL_CAPACITY=4096
CROWDRELAY_CLICK_BATCH_SIZE=250
CROWDRELAY_CLICK_FLUSH_INTERVAL_MS=500
CROWDRELAY_RANDOM_DRAWS_ENABLED=false

# Push delivery — fan notifications via Signal. The process-level gate
# (CROWDRELAY_PUSH_DELIVERY_ENABLED) must be true AND the per-workspace
# feature flag `push_delivery_enabled` must be enabled in the database.
CROWDRELAY_PUSH_DELIVERY_ENABLED=false
# Firebase Cloud Messaging (Android push). Both must be set together.
CROWDRELAY_FCM_PROJECT_ID=
CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE=
# Web Push (browser/desktop push). All three must be set together.
CROWDRELAY_WEB_PUSH_VAPID_PUBLIC_KEY=
CROWDRELAY_WEB_PUSH_VAPID_PRIVATE_KEY=
CROWDRELAY_WEB_PUSH_SUBJECT=mailto:operator@virya.music

# YouTube Data API v3 key (server-side, IP-restricted). Used by the growth
# metric sync worker to fetch channel subscriber counts. No OAuth needed.
CROWDRELAY_YOUTUBE_API_KEY=

# Spotify — no credentials needed. The growth metric sync worker uses
# Spotify's internal partner API (public embed page token + pathfinder
# GraphQL) to fetch artist follower counts. No app registration required.

# Facebook Graph API Page access token. Used by the growth metric sync
# worker to fetch Page follower counts. Get a Page token via the Graph API
# Explorer with pages_read_engagement permission. No App Review needed for
# pages you own.
CROWDRELAY_FACEBOOK_PAGE_ACCESS_TOKEN=

# TikTok Display API credentials. Used by the growth metric sync worker
# to fetch TikTok creator follower counts. Create an app at
# https://developers.tiktok.com to get these.
CROWDRELAY_TIKTOK_CLIENT_KEY=
CROWDRELAY_TIKTOK_CLIENT_SECRET=

# Narrow tenant-management credentials. Keep these two roles separate in production.
CROWDRELAY_CONTROL_PLANE_AREA_API_KEY=
CROWDRELAY_CONTROL_PLANE_API_KEY=

# Auth key for the agents service (Reddit browser, LLM workers).
# Must match AGENT_SERVICE_AUTH_KEY in crowdrelay-agents/.env.
# Synced automatically by crowdrelay-control-plane/scripts/up.sh.
CROWDRELAY_AGENT_SERVICE_AUTH_KEY=

RUST_LOG=info,crowdrelay=debug
