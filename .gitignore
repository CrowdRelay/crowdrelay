target/
.env
*.log
*.dump
*.dump.*
*.age
.DS_Store
.idea/
.vscode/
coverage/
*.pyc
__pycache__/

# Local operator state. Deployment-specific filenames belong in
# .git/info/exclude so they are never documented by the public repository.
.crowdrelay.local.sh
.crowdrelay-artifacts/
/artifacts/
.crowdrelay-maintenance.lock
deploy/.env.*
!deploy/env.production.example
deploy/*.production.json
deploy/backups/
backups/

# n8n is private by default. Only provider-neutral documentation and examples
# are part of the public repository. The executor contract is whitelisted too:
# two test gates read it verbatim, so an untracked copy means green locally
# and FileNotFoundError on every runner.
n8n/*
!n8n/README.md
!n8n/viryaos-executor-contract.md
!n8n/examples/
!n8n/examples/**

# Docs are local-only except for the canonical architecture document.
docs/*
!docs/ARCHITECTURE.md

# AppleDouble sidecars, written whenever a macOS copy reaches a host. They
# leave the production worktree dirty and the deploy preflight refuses it.
._*

# Editor/recovery files must never enter source packages. Manual pre-edit
# snapshots on production are timestamped (`Caddyfile.bak-20260826T103002`),
# not just `*.bak`, and left the deploy preflight refusing a clean worktree.
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*~
.recovery-backup

# Edge Basic Auth credential material for the Control Plane. Generated once
# on the production host; the bcrypt hash and env file are secrets, not
# source, so they stay off disk here the same way deploy/*.production.json
# does.
ops/edge/control-plane-basic.bcrypt
ops/edge/control-plane-basic.env

CLAUDE.md
PHA*
.claude/
scripts/migrate-to-*.sh
scripts/provision-*.sh

# Local-only PG upgrade tooling (untracked by request)
scripts/local/
backups-local/
chrome/
