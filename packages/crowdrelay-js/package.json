{
  "name": "@crowdrelay/client",
  "version": "0.1.0",
  "description": "Typed, dependency-free browser client for CrowdRelay",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/wojciechbator/crowdrelay"
}
