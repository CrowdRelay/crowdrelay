# Installed at ${EDGE_ROOT}/edge.env on the production host, mode 0600.
# Sourced with `set -a` before `docker compose -f ops/edge/compose.edge.yaml`.
#
# Every value containing '$' MUST be single quoted. Sourcing this file with
# `set -a` runs it through the shell, so an unquoted Argon2id hash has its
# $argon2id, $v and $m segments expanded away to nothing and Caddy then fails
# with "base64-decoding password: illegal base64 data at input byte 0".

EDGE_ROOT=/opt/virya-n8n
VIRYA_EDGE_PUBLIC_HOST=n8n.virya.music
VIRYA_EDGE_NETWORK=virya-edge

# host:port of the n8n stack on virya-home, reached over WireGuard wg0.
# Placeholder address; substitute the peer's real wg0 address.
VIRYA_N8N_UPSTREAM=192.0.2.2:5678

# Output of `caddy hash-password`, single quoted.
CONTROL_PLANE_STAFF_PASSWORD_HASH='$argon2id$v=19$m=...$...$...'
