{
	servers :443 {
		protocols h1 h2 h3
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The applications behind this edge send no security headers of their
		# own, so clickjacking protection has to originate here. The policy is
		# deliberately limited to frame-ancestors: a fuller CSP would have to be
		# written against each app's own script and style sources.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	import security_headers



	handle {
		# n8n runs on virya-home, which has no public address, so this is the
		# host's WireGuard peer. Supplied by the environment, not tracked.
		reverse_proxy {$VIRYA_N8N_UPSTREAM} {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 2s
				response_header_timeout 120s
				keepalive 120s
			}
		}
	}

	log {
		output stdout
		format console
	}
}

# BEGIN CROWDRELAY SIGNAL API
signal-api.virya.music {
	encode zstd gzip
	import security_headers

	request_body {
		max_size 32KB
	}

	reverse_proxy crowdrelay-api:8080 {
		health_uri /v1/health/ready
		health_interval 30s
		transport http {
			dial_timeout 2s
			response_header_timeout 10s
		}
	}
}
# END CROWDRELAY SIGNAL API

# BEGIN CROWDRELAY CONTROL PLANE
# Managed CrowdRelay Control Plane edge block.
# The SPA shell stays public; every /api/v1/* call requires Basic credentials.
# basic_auth emits its WWW-Authenticate challenge onto the shared response
# writer before returning the 401 error; browsers answer that header with the
# native credential dialog beside the styled login form. Deferred deletions
# never see the challenge, so handle_errors rewrites the 401 without it:
# same status and empty body, no native credential dialog.
control.virya.music {
    encode zstd gzip
    import security_headers

    @immutable path /assets/* /crowdrelay-brand-mark.png /favicon.ico
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    route {

        # Operator session endpoints are public transport: the backend owns
        # credential verification, cookie issuance and revocation.
        @auth path /api/v1/auth/*
        handle @auth {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }

        # Cookie-bearing requests skip edge Basic auth and pass through
        # untouched; the backend validates the HttpOnly operator session
        # itself and fails closed.
        @session_request header Cookie *crowdrelay_cp_session=*
        handle @session_request {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }
        @runtime_put {
            method PUT
            path /api/v1/tenants/*/runtime
        }
        handle @runtime_put {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 10s
                }
            }
        }

        # Machine-to-machine automation event ingestion (n8n → control plane).
        # Bearer token auth, not Basic — the backend validates the automation token.
        @automation_ingest path /api/v1/automation/events
        handle @automation_ingest {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
            }
        }

        @provisioner path /api/v1/provisioner/*
        handle @provisioner {
            reverse_proxy control-plane:8090 {
                health_uri /healthz/ready
                health_interval 15s
                health_timeout 3s
                transport http {
                    dial_timeout 2s
                    response_header_timeout 10s
                }
            }
        }

        @api {
            not path /api/v1/automation/events
            path /api/v1/*
            not path /api/v1/tenants/*/runtime
        }
        basic_auth @api {
            operator {file./config/control-plane-basic.bcrypt}
        }

        @runtime_read {
            method GET
            path /api/v1/tenants/*/runtime
        }
        basic_auth @runtime_read {
            operator {file./config/control-plane-basic.bcrypt}
        }

        reverse_proxy control-plane:8090 {
            health_uri /healthz/ready
            health_interval 15s
            health_timeout 3s
            lb_try_duration 3s
            header_up Authorization "Bearer {file./config/control-plane-admin-token}"
            header_up X-Control-Plane-Edge "oracle-caddy"
            transport http {
                dial_timeout 2s
                response_header_timeout 10s
                keepalive 60s
            }
        }
    }

    log {
        output stdout
        format console
    }

    handle_errors {
        @unauthorized expression {err.status_code} == 401
        route {
            header @unauthorized -WWW-Authenticate
            respond @unauthorized "" 401
        }
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
# END CROWDRELAY CONTROL PLANE

# BEGIN KERN OPERATOR PANEL
# Kern runs on virya-home (10.77.0.2 via WireGuard). The panel is
# operator-only; the operator token gate is in the app itself.
kern.wojciechbator.me {
