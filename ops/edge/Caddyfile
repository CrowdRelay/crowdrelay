	import security_headers

	reverse_proxy 10.77.0.2:8090 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 2s
			response_header_timeout 10s
		}
	}

	log {
		output stdout
		format console
	}
}
# END KERN OPERATOR PANEL
