#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LOCAL_CONFIG="${CROWDRELAY_LOCAL_CONFIG:-${ROOT_DIR}/.crowdrelay.local.sh}"

CROWDRELAY_IMAGE_SHA="${CROWDRELAY_IMAGE_SHA:-}"
CROWDRELAY_COMPOSE_FILE="${CROWDRELAY_COMPOSE_FILE:-compose.production.yaml}"
CROWDRELAY_ENV_FILE="${CROWDRELAY_ENV_FILE:-deploy/.env.production}"
CROWDRELAY_BOOTSTRAP_FILE="${CROWDRELAY_BOOTSTRAP_FILE:-deploy/bootstrap.production.json}"
CROWDRELAY_WEBHOOK_SECRETS_FILE="${CROWDRELAY_WEBHOOK_SECRETS_FILE:-deploy/webhook-secrets.production.json}"
CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE="${CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE:-deploy/secrets/firebase-service-account.json}"
CROWDRELAY_DOCKER_NETWORK="${CROWDRELAY_DOCKER_NETWORK:-crowdrelay}"
CROWDRELAY_CREATE_NETWORK="${CROWDRELAY_CREATE_NETWORK:-false}"
CROWDRELAY_PUBLIC_BASE_URL="${CROWDRELAY_PUBLIC_BASE_URL:-}"
CROWDRELAY_LEDGER_COMMERCE_API_KEY="${CROWDRELAY_LEDGER_COMMERCE_API_KEY:-}"
CROWDRELAY_CONTROL_PLANE_BASE_URL="${CROWDRELAY_CONTROL_PLANE_BASE_URL:-}"
CROWDRELAY_CONTROL_PLANE_TELEMETRY_TOKEN="${CROWDRELAY_CONTROL_PLANE_TELEMETRY_TOKEN:-}"
CROWDRELAY_CONTROL_PLANE_TENANT_SLUG="${CROWDRELAY_CONTROL_PLANE_TENANT_SLUG:-}"
CROWDRELAY_BACKUP_BEFORE_DEPLOY="${CROWDRELAY_BACKUP_BEFORE_DEPLOY:-false}"
CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS="${CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS:-180}"
CROWDRELAY_AREA_MANAGEMENT_ENABLED="${CROWDRELAY_AREA_MANAGEMENT_ENABLED:-false}"
CROWDRELAY_SSH_TARGET="${CROWDRELAY_SSH_TARGET:-}"
CROWDRELAY_REMOTE_INSTALL_DIR="${CROWDRELAY_REMOTE_INSTALL_DIR:-/srv/crowdrelay}"
CROWDRELAY_REMOTE_ARCHIVE="${CROWDRELAY_REMOTE_ARCHIVE:-/tmp/crowdrelay-deploy.tar.gz}"

if [[ -f "$LOCAL_CONFIG" ]]; then
  [[ ! -L "$LOCAL_CONFIG" ]] || {
    echo "Refusing to source symlinked local config: $LOCAL_CONFIG" >&2
    exit 1
  }
  # shellcheck source=/dev/null
  source "$LOCAL_CONFIG"
fi

cd "$ROOT_DIR"

usage() {
  cat <<'USAGE'
Usage: ./crowdrelayctl <command> [args]

  init                 Create ignored local config and production files
  doctor               Validate local configuration and Compose
  pin <full-sha>       Save the immutable image revision locally
  status               Show Compose service status
  deploy               Pull, run setup, start API/worker, verify
  verify               Check local and optional public health endpoints
  heartbeat            Report runtime status to the Control Plane once
  logs [service]       Follow logs for all services or one service
  resources            Read-only memory/swap report for the production host
  backup               Run crowdrelay_backup hook from local config
  package [path]       Build a private deployment archive
  ship                 Package, upload and deploy over SSH
  rollback <full-sha>  Pin an older revision and deploy it
USAGE
}

absolute_path() {
  local path="$1"
  if [[ "$path" = /* ]]; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "$ROOT_DIR" "$path"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

require_regular_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || {
    echo "Missing or unsafe file: $path" >&2
    exit 1
  }
}

sha256_file() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$file" | awk '{print $1}'; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$file" | awk '{print $1}'; else echo "Missing SHA-256 utility" >&2; exit 1; fi
}

sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d " " -f1; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d " " -f1; else echo "Missing SHA-256 utility" >&2; exit 1; fi
}

validate_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || {
    echo "Expected a full lowercase 40-character Git commit SHA." >&2
    exit 2
  }
}

run_hook() {
  local hook="$1"
  shift
  if declare -F "$hook" >/dev/null 2>&1; then
    "$hook" "$@"
  fi
}

report_release_ledger() {
  [[ -n "$CROWDRELAY_LEDGER_COMMERCE_API_KEY" ]] || return 0
  if [[ -z "$CROWDRELAY_PUBLIC_BASE_URL" ]]; then
    echo "Release ledger reporter skipped: CROWDRELAY_PUBLIC_BASE_URL is empty." >&2
    return 0
  fi
  local reporter="${ROOT_DIR}/scripts/report-release-component.sh"
  if [[ ! -x "$reporter" ]]; then
    echo "Release ledger reporter skipped: $reporter is missing or not executable." >&2
    return 0
  fi
  local dependency_lock_sha
  dependency_lock_sha="$(sha256sum "${ROOT_DIR}/Cargo.lock" | awk '{print $1}')"
  local component service container_id artifact_digest
  for component in crowdrelay-api crowdrelay-worker; do
    service="api"
    [[ "$component" == "crowdrelay-worker" ]] && service="worker"
    container_id="$(compose ps -q "$service" 2>/dev/null || true)"
    artifact_digest=""
    if [[ -n "$container_id" ]]; then
      artifact_digest="$(docker inspect "$container_id" --format '{{.Image}}' 2>/dev/null || true)"
    fi
    if ! CROWDRELAY_BASE_URL="$CROWDRELAY_PUBLIC_BASE_URL" \
      CROWDRELAY_COMMERCE_API_KEY="$CROWDRELAY_LEDGER_COMMERCE_API_KEY" \
      COMPONENT_KEY="$component" \
      SOURCE_SHA="$CROWDRELAY_IMAGE_SHA" \
      ARTIFACT_DIGEST="$artifact_digest" \
      DEPENDENCY_LOCK_SHA256="$dependency_lock_sha" \
      DEPLOY_REF="crowdrelayctl" \
      "$reporter"; then
      echo "Release ledger reporter failed for $component; production deploy remains valid." >&2
    fi
  done
}

report_control_plane_runtime() {
  [[ -n "$CROWDRELAY_CONTROL_PLANE_BASE_URL" ]] || return 0
  [[ -n "$CROWDRELAY_CONTROL_PLANE_TELEMETRY_TOKEN" ]] || return 0
  [[ -n "$CROWDRELAY_CONTROL_PLANE_TENANT_SLUG" ]] || return 0
  local reporter="${ROOT_DIR}/scripts/report-control-plane-runtime.sh"
  if [[ ! -x "$reporter" ]]; then
    echo "Control Plane runtime reporter skipped: $reporter is missing or not executable." >&2
    return 0
  fi

  # Health is observed, never assumed. A failing probe reports false so the
  # Control Plane can show degraded; only an unobservable value stays empty,
  # which the reporter sends as null.
  #
  # One `compose exec` covers both readings. /metrics is only bound inside the
  # compose network, so it is reached the same way verify() reaches readiness —
  # and it answers 503 unless the database-backed ops snapshot succeeded, so a
  # 200 already proves what /v1/health/ready would have. This runs every 60s
  # under the heartbeat timer, where a second `docker compose exec` costs more
  # CPU than the reading is worth.
  local api_healthy worker_healthy outbox_pending worker_id metrics
  api_healthy=false
  metrics="$(compose exec -T api curl --fail --silent --show-error --connect-timeout 2 --max-time 10 \
    http://127.0.0.1:8080/metrics 2>/dev/null </dev/null || true)"
  [[ -n "$metrics" ]] && api_healthy=true

  worker_healthy=""
  worker_id="$(compose ps -q worker 2>/dev/null || true)"
  if [[ -n "$worker_id" ]]; then
    case "$(docker inspect "$worker_id" --format '{{.State.Health.Status}}' 2>/dev/null || true)" in
      healthy) worker_healthy=true ;;
      "") worker_healthy="" ;;
      *) worker_healthy=false ;;
    esac
  fi

  outbox_pending="$(printf '%s\n' "$metrics" \
    | awk '$1 == "crowdrelay_outbox_pending" { print $2; exit }')"
  [[ "$outbox_pending" =~ ^[0-9]+$ ]] || outbox_pending=""

  if ! CONTROL_PLANE_BASE_URL="$CROWDRELAY_CONTROL_PLANE_BASE_URL" \
    CONTROL_PLANE_TELEMETRY_TOKEN="$CROWDRELAY_CONTROL_PLANE_TELEMETRY_TOKEN" \
    CONTROL_PLANE_TENANT_SLUG="$CROWDRELAY_CONTROL_PLANE_TENANT_SLUG" \
    API_HEALTHY="$api_healthy" \
    WORKER_HEALTHY="$worker_healthy" \
    DEPLOYED_SHA="$CROWDRELAY_IMAGE_SHA" \
    OUTBOX_PENDING="$outbox_pending" \
    "$reporter"; then
    echo "Control Plane runtime report failed; production deploy remains valid." >&2
  fi
}

compose() {
  local env_file compose_file
  local -a compose_args

  env_file="$(absolute_path "$CROWDRELAY_ENV_FILE")"
  compose_file="$(absolute_path "$CROWDRELAY_COMPOSE_FILE")"

  export CROWDRELAY_ENV_FILE="$env_file"
  export CROWDRELAY_BOOTSTRAP_HOST_FILE="$(absolute_path "$CROWDRELAY_BOOTSTRAP_FILE")"
  export CROWDRELAY_WEBHOOK_SECRETS_HOST_FILE="$(absolute_path "$CROWDRELAY_WEBHOOK_SECRETS_FILE")"
  export CROWDRELAY_FCM_SERVICE_ACCOUNT_HOST_FILE="$(absolute_path "$CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE")"
  export CROWDRELAY_DOCKER_NETWORK
  if [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]]; then export CROWDRELAY_AREA_MANAGEMENT_CONFIG_SHA256="$(sha256_file "$ROOT_DIR/deploy/area-management.Caddyfile")"; fi
  export CROWDRELAY_IMAGE_TAG="sha-${CROWDRELAY_IMAGE_SHA}"

  compose_args=(
    --env-file "$env_file"
    --file "$compose_file"
  )

  if [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]]; then
    compose_args+=(--file "$ROOT_DIR/compose.area-management.yaml")
  fi

  docker compose "${compose_args[@]}" "$@"
}

runtime_owner_uid() {
  if [[ -n "${SUDO_UID:-}" ]]; then
    printf '%s\n' "$SUDO_UID"
  else
    id -u
  fi
}

run_privileged() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
    return
  fi
  require_command sudo
  sudo "$@"
}

prepare_runtime_file_permissions() {
  local owner_uid runtime_gid bootstrap_file secrets_file fcm_file file current_uid current_gid current_mode
  owner_uid="$(runtime_owner_uid)"
  runtime_gid="10001"
  bootstrap_file="$(absolute_path "$CROWDRELAY_BOOTSTRAP_FILE")"
  secrets_file="$(absolute_path "$CROWDRELAY_WEBHOOK_SECRETS_FILE")"
  fcm_file="$(absolute_path "$CROWDRELAY_FCM_SERVICE_ACCOUNT_FILE")"

  # These files are bind-mounted into containers running as 10001:10001.
  # Keep them deploy-user readable for future ships, group-readable by the
  # runtime identity, and never world-readable.
  for file in "$bootstrap_file" "$secrets_file" "$fcm_file"; do
    require_regular_file "$file"
    current_uid="$(stat -c '%u' "$file")"
    current_gid="$(stat -c '%g' "$file")"
    current_mode="$(stat -c '%a' "$file")"
    if [[ "$current_uid" != "$owner_uid" || "$current_gid" != "$runtime_gid" || "$current_mode" != "640" ]]; then
      run_privileged chown "${owner_uid}:${runtime_gid}" "$file"
      run_privileged chmod 0640 "$file"
    fi
  done
}

init_files() {
  if [[ ! -e "$LOCAL_CONFIG" ]]; then
    cp .crowdrelay.local.sh.example "$LOCAL_CONFIG"
    chmod 600 "$LOCAL_CONFIG"
    echo "Created $LOCAL_CONFIG"
  fi

  local env_file bootstrap_file secrets_file
  env_file="$(absolute_path "$CROWDRELAY_ENV_FILE")"
  bootstrap_file="$(absolute_path "$CROWDRELAY_BOOTSTRAP_FILE")"
  secrets_file="$(absolute_path "$CROWDRELAY_WEBHOOK_SECRETS_FILE")"
  mkdir -p "$(dirname "$env_file")" "$(dirname "$bootstrap_file")" "$(dirname "$secrets_file")"

  if [[ ! -e "$env_file" ]]; then
    cp deploy/env.production.example "$env_file"
    chmod 600 "$env_file"
    echo "Created $env_file"
  fi
  if [[ ! -e "$bootstrap_file" ]]; then
    cp deploy/bootstrap.example.json "$bootstrap_file"
    chmod 600 "$bootstrap_file"
    echo "Created $bootstrap_file"
  fi
  if [[ ! -e "$secrets_file" ]]; then
    cp deploy/webhook-secrets.example.json "$secrets_file"
    chmod 600 "$secrets_file"
    echo "Created $secrets_file"
  fi
}

doctor() {
  require_command docker
  docker compose version >/dev/null
  validate_sha "$CROWDRELAY_IMAGE_SHA"
  require_regular_file "$(absolute_path "$CROWDRELAY_COMPOSE_FILE")"
  require_regular_file "$(absolute_path "$CROWDRELAY_ENV_FILE")"
  require_regular_file "$(absolute_path "$CROWDRELAY_BOOTSTRAP_FILE")"
  require_regular_file "$(absolute_path "$CROWDRELAY_WEBHOOK_SECRETS_FILE")"

  case "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" in
    true)
      require_regular_file "$ROOT_DIR/compose.area-management.yaml"
      require_regular_file "$ROOT_DIR/deploy/area-management.Caddyfile"
      ;;
    false)
      ;;
    *)
      echo "CROWDRELAY_AREA_MANAGEMENT_ENABLED must be true or false." >&2
      exit 1
      ;;
  esac

  compose config --quiet
  if [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]]; then compose run --rm -T --no-deps --entrypoint caddy area-management-proxy validate --config /etc/caddy/Caddyfile >/dev/null </dev/null; fi
  echo "Configuration is valid for sha-${CROWDRELAY_IMAGE_SHA}."
}

pin_sha() {
  local sha="$1"
  validate_sha "$sha"
  [[ -f "$LOCAL_CONFIG" ]] || init_files
  require_command python3
  python3 - "$LOCAL_CONFIG" "$sha" <<'PY'
from pathlib import Path
import re
import sys
path = Path(sys.argv[1])
sha = sys.argv[2]
text = path.read_text(encoding="utf-8")
line = f'CROWDRELAY_IMAGE_SHA="{sha}"'
if re.search(r'^CROWDRELAY_IMAGE_SHA=.*$', text, flags=re.MULTILINE):
    text = re.sub(r'^CROWDRELAY_IMAGE_SHA=.*$', line, text, count=1, flags=re.MULTILINE)
else:
    text = line + "\n" + text
path.write_text(text, encoding="utf-8")
PY
  chmod 600 "$LOCAL_CONFIG"
  CROWDRELAY_IMAGE_SHA="$sha"
  echo "Pinned sha-${sha}."
}


verify_exact_release_identity() {
  require_command python3
  local service container_id configured_image image_id revision meta
  for service in api worker; do
    container_id="$(compose ps -q "$service")"
    [[ -n "$container_id" ]] || {
      echo "Exact-SHA verification failed: missing running $service container." >&2
      exit 1
    }
    configured_image="$(docker inspect --format '{{.Config.Image}}' "$container_id")"
    [[ "$configured_image" == *":sha-${CROWDRELAY_IMAGE_SHA}" ]] || {
      echo "Exact-SHA verification failed for $service: image=$configured_image expected tag sha-${CROWDRELAY_IMAGE_SHA}." >&2
      exit 1
    }
    image_id="$(docker inspect --format '{{.Image}}' "$container_id")"
    revision="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image_id")"
    [[ "$revision" == "$CROWDRELAY_IMAGE_SHA" ]] || {
      echo "Exact-SHA verification failed for $service: OCI revision=$revision expected=${CROWDRELAY_IMAGE_SHA}." >&2
      exit 1
    }
  done

  meta="$(compose exec -T api curl --fail --silent --show-error --connect-timeout 2 --max-time 10 \
    http://127.0.0.1:8080/v1/meta </dev/null)"
  printf '%s' "$meta" | python3 -c '
import json
import sys
expected = sys.argv[1]
data = json.load(sys.stdin)
actual = data.get("gitSha")
if actual != expected:
    raise SystemExit(f"Exact-SHA verification failed for API runtime metadata: gitSha={actual!r} expected={expected!r}")
' "$CROWDRELAY_IMAGE_SHA"
  echo "EXACT_SHA_GATE=PASS sha-${CROWDRELAY_IMAGE_SHA}"
}

verify() {
  require_command docker
  compose exec -T api curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 2 --max-time 10 \
    http://127.0.0.1:8080/v1/health/live >/dev/null </dev/null
  compose exec -T api curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 2 --max-time 10 \
    http://127.0.0.1:8080/v1/health/ready >/dev/null </dev/null
  compose exec -T api curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 2 --max-time 10 \
    'http://127.0.0.1:8080/v1/public/cities?limit=100' >/dev/null </dev/null
  compose exec -T api curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 2 --max-time 10 \
    'http://127.0.0.1:8080/v1/public/events?limit=50' >/dev/null </dev/null

  if [[ -n "$CROWDRELAY_PUBLIC_BASE_URL" ]]; then
    require_command curl
    local base="${CROWDRELAY_PUBLIC_BASE_URL%/}"
    curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 3 --max-time 15 "$base/v1/health/live" >/dev/null
    curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 3 --max-time 15 "$base/v1/health/ready" >/dev/null
    curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 3 --max-time 15 "$base/v1/public/cities?limit=100" >/dev/null
    curl --fail --silent --show-error --retry 3 --retry-delay 1 --retry-all-errors --connect-timeout 3 --max-time 15 "$base/v1/public/events?limit=50" >/dev/null
  fi
  run_hook crowdrelay_after_verify
  echo "CrowdRelay is healthy."
}

verify_management_proxy() {
  [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]] || return 0
  require_command curl
  local container status runtime_caddy source_sha runtime_sha endpoint status_code route
  container="$(compose ps -q area-management-proxy)"
  [[ -n "$container" ]] || { echo "Management proxy is missing after deploy." >&2; exit 1; }
  status="$(docker inspect --format "{{.State.Status}}" "$container")"
  [[ "$status" == "running" ]] || { echo "Management proxy is not running: $status" >&2; exit 1; }
  runtime_caddy="$(docker exec "$container" cat /etc/caddy/Caddyfile)" || { echo "Cannot read live management Caddyfile." >&2; exit 1; }
  source_sha="$(sha256_file "$ROOT_DIR/deploy/area-management.Caddyfile")"
  runtime_sha="$(printf "%s\n" "$runtime_caddy" | sha256_stdin)"
  [[ "$runtime_sha" == "$source_sha" ]] || { echo "Management proxy Caddyfile drift: runtime=$runtime_sha source=$source_sha" >&2; exit 1; }
  docker exec "$container" caddy validate --config /etc/caddy/Caddyfile >/dev/null
  for route in "/v1/control-plane/area" "/v1/control-plane/ops/summary" "/v1/control-plane/ecosystem/flags" "/v1/control-plane/autopilot/overview"; do grep -Fq "$route" <<<"$runtime_caddy" || { echo "Management proxy missing route: $route" >&2; exit 1; }; done
  endpoint="$(docker port "$container" 18080/tcp | head -n1)"
  [[ -n "$endpoint" ]] || { echo "Management proxy has no published 18080 endpoint." >&2; exit 1; }
  status_code="$(curl -sS -o /dev/null -w "%{http_code}" --connect-timeout 3 --max-time 10 "http://${endpoint}/v1/control-plane/ops/summary")"
  [[ "$status_code" == "401" ]] || { echo "Management routing gate failed: expected=401 got=$status_code" >&2; exit 1; }
  echo "MANAGEMENT_PROXY=PASS config=current routing=401"
}

deploy() {
  prepare_runtime_file_permissions
  doctor
  if ! docker network inspect "$CROWDRELAY_DOCKER_NETWORK" >/dev/null 2>&1; then
    if [[ "$CROWDRELAY_CREATE_NETWORK" == "true" ]]; then
      docker network create "$CROWDRELAY_DOCKER_NETWORK" >/dev/null
    else
      echo "Missing Docker network: $CROWDRELAY_DOCKER_NETWORK" >&2
      exit 1
    fi
  fi

  if [[ "$CROWDRELAY_BACKUP_BEFORE_DEPLOY" == "true" ]]; then
    if declare -F crowdrelay_backup >/dev/null 2>&1; then
      crowdrelay_backup
    else
      echo "CROWDRELAY_BACKUP_BEFORE_DEPLOY=true but crowdrelay_backup() is not defined." >&2
      exit 1
    fi
  fi
  [[ "$CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
    echo "CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
    exit 1
  }
  run_hook crowdrelay_before_deploy
  compose pull
  compose run --rm -T setup </dev/null
  local -a deploy_services=(api worker)

  if [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]]; then
    deploy_services+=(area-management-proxy)
  fi

  compose up --detach --wait --wait-timeout "$CROWDRELAY_DEPLOY_WAIT_TIMEOUT_SECONDS" --remove-orphans "${deploy_services[@]}"
  verify_management_proxy
  verify_exact_release_identity
  run_hook crowdrelay_before_verify
  verify
  report_release_ledger
  report_control_plane_runtime
  run_hook crowdrelay_after_deploy
  run_hook crowdrelay_notify "CrowdRelay deployed: sha-${CROWDRELAY_IMAGE_SHA}"
}

package_deploy() (
  set -euo pipefail
  local output="${1:-${ROOT_DIR}/.crowdrelay-artifacts/crowdrelay-${CROWDRELAY_IMAGE_SHA}.tar.gz}"
  doctor >&2
  require_command tar
  local staging
  staging="$(mktemp -d)"
  trap 'rm -rf -- "$staging"' EXIT
  mkdir -p "$staging/deploy"
  cp crowdrelayctl "$staging/crowdrelayctl"
  mkdir -p "$staging/scripts"
  cp scripts/report-release-component.sh "$staging/scripts/report-release-component.sh"
  cp scripts/report-control-plane-runtime.sh "$staging/scripts/report-control-plane-runtime.sh"
  cp scripts/production-smoke.sh "$staging/scripts/production-smoke.sh"
  cp Cargo.lock "$staging/Cargo.lock"
  chmod 700 \
    "$staging/scripts/report-release-component.sh" \
    "$staging/scripts/report-control-plane-runtime.sh" \
    "$staging/scripts/production-smoke.sh"
  cp -R deploy/systemd "$staging/deploy/systemd"
  cp "$(absolute_path "$CROWDRELAY_COMPOSE_FILE")" "$staging/compose.production.yaml"

  if [[ "$CROWDRELAY_AREA_MANAGEMENT_ENABLED" == "true" ]]; then
    cp "$ROOT_DIR/compose.area-management.yaml" "$staging/compose.area-management.yaml"
    cp "$ROOT_DIR/deploy/area-management.Caddyfile" "$staging/deploy/area-management.Caddyfile"
  fi

  cp "$LOCAL_CONFIG" "$staging/.crowdrelay.local.sh"
  cp "$(absolute_path "$CROWDRELAY_ENV_FILE")" "$staging/deploy/.env.production"
  cp "$(absolute_path "$CROWDRELAY_BOOTSTRAP_FILE")" "$staging/deploy/bootstrap.production.json"
  cp "$(absolute_path "$CROWDRELAY_WEBHOOK_SECRETS_FILE")" "$staging/deploy/webhook-secrets.production.json"
  chmod 700 "$staging/crowdrelayctl"
  chmod 600 "$staging/.crowdrelay.local.sh" "$staging/deploy/"*
  mkdir -p "$(dirname "$output")"
  tar -C "$staging" -czf "$output" .
  chmod 600 "$output"
  run_hook crowdrelay_after_package "$output" >&2
  printf '%s\n' "$output"
)

# Read-only. Answers "what is actually resident on this box" with numbers
# instead of guesses: memory and swap, the processes and containers holding it,
# what PostgreSQL reserved, and whether anything from a retired Node/n8n
# install is still running or still on disk. Never mutates the host.
RESOURCE_REPORT=$(cat <<'REMOTE'
set -uo pipefail
line() { printf '\n== %s ==\n' "$1"; }

line "shape"
printf 'arch=%s cores=%s\n' "$(uname -m)" "$(nproc 2>/dev/null || echo unknown)"
[ -r /sys/devices/virtual/dmi/id/product_name ] && cat /sys/devices/virtual/dmi/id/product_name
grep -m1 'model name' /proc/cpuinfo 2>/dev/null || true

line "memory and swap (MiB)"
free -m 2>/dev/null || cat /proc/meminfo | head -5

line "swap pressure"
if [ -r /proc/pressure/memory ]; then cat /proc/pressure/memory; fi
awk '/^(pswpin|pswpout)/ {print}' /proc/vmstat 2>/dev/null
printf 'swappiness=%s\n' "$(cat /proc/sys/vm/swappiness 2>/dev/null || echo unknown)"
printf 'zram devices: %s\n' "$(ls -1 /dev/zram* 2>/dev/null | tr '\n' ' ' || echo none)"
swapon --show 2>/dev/null || true

line "top 12 processes by resident size"
ps -eo rss=,comm=,args= --sort=-rss 2>/dev/null | head -12 |
  awk '{ printf "%8.1f MiB  %s\n", $1/1024, substr($0, index($0,$2)) }'

line "container memory"
docker stats --no-stream --format 'table {{.Name}}\t{{.MemUsage}}\t{{.MemPerc}}' 2>/dev/null ||
  echo "docker stats unavailable for this user"

line "postgresql reservation"
pg=$(docker ps --filter 'ancestor=postgres' --format '{{.Names}}' 2>/dev/null | head -1)
[ -z "$pg" ] && pg=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -i postgres | head -1)
if [ -n "$pg" ]; then
  docker exec "$pg" psql -U "${POSTGRES_USER:-crowdrelay}" -d "${POSTGRES_DB:-crowdrelay}" -Atc \
    "SELECT name||' = '||setting||COALESCE(' '||unit,'') FROM pg_settings
     WHERE name IN ('shared_buffers','work_mem','maintenance_work_mem','max_connections',
                    'effective_cache_size','autovacuum_work_mem','io_workers','max_worker_processes')
     ORDER BY name" 2>/dev/null || echo "psql unavailable inside $pg"
  docker exec "$pg" psql -U "${POSTGRES_USER:-crowdrelay}" -d "${POSTGRES_DB:-crowdrelay}" -Atc \
    "SELECT 'backends = '||count(*) FROM pg_stat_activity" 2>/dev/null || true
else
  echo "no postgres container found on this host"
fi

line "retired Node/n8n footprint"
docker ps -a --format '{{.Names}} {{.Image}} {{.Status}}' 2>/dev/null | grep -iE 'n8n|node' ||
  echo "containers: none"
docker images --format '{{.Repository}}:{{.Tag}} {{.Size}}' 2>/dev/null | grep -iE 'n8n|node' ||
  echo "images: none"
docker volume ls --format 'volume: {{.Name}}' 2>/dev/null | grep -iE 'n8n|node' || echo "volumes: none"
systemctl list-units --type=service --all --no-legend --no-pager 2>/dev/null |
  grep -iE 'n8n|node' || echo "services: none"
runtime_procs=$(ps -eo pid=,comm= 2>/dev/null | awk '$2 ~ /^(node|nodejs|n8n)$/ { print "process: " $1 " " $2 }')
[ -n "$runtime_procs" ] && printf '%s\n' "$runtime_procs" || echo "processes: none"
for path in /usr/lib/node_modules /usr/local/lib/node_modules "$HOME/.n8n" /var/lib/n8n /opt/n8n; do
  [ -e "$path" ] && printf 'on disk: %s (%s)\n' "$path" "$(du -sh "$path" 2>/dev/null | cut -f1)"
done
printf 'node binary: %s\n' "$(command -v node 2>/dev/null || echo absent)"

line "reclaimable docker data"
docker system df 2>/dev/null || echo "docker system df unavailable"
REMOTE
)

resources() {
  if [[ -n "$CROWDRELAY_SSH_TARGET" ]]; then
    require_command ssh
    printf 'Reading %s\n' "$CROWDRELAY_SSH_TARGET"
    ssh "$CROWDRELAY_SSH_TARGET" bash -s <<<"$RESOURCE_REPORT"
  else
    echo "CROWDRELAY_SSH_TARGET is empty; reporting on this machine." >&2
    bash -s <<<"$RESOURCE_REPORT"
  fi
}

ship() {
  [[ -n "$CROWDRELAY_SSH_TARGET" ]] || {
    echo "Set CROWDRELAY_SSH_TARGET in $LOCAL_CONFIG" >&2
    exit 1
  }
  require_command scp
  require_command ssh
  local archive
  archive="$(package_deploy)"
  scp "$archive" "${CROWDRELAY_SSH_TARGET}:${CROWDRELAY_REMOTE_ARCHIVE}"
  ssh "$CROWDRELAY_SSH_TARGET" bash -s -- \
    "$CROWDRELAY_REMOTE_INSTALL_DIR" "$CROWDRELAY_REMOTE_ARCHIVE" <<'REMOTE'
# Remote body runs as one brace group with stdin detached. bash reads this
# script from ssh stdin; any command that attaches stdin (docker compose
# run/exec) would otherwise swallow the remainder and silently skip it.
{
set -euo pipefail
install_dir="$1"
archive="$2"
mkdir -p "$install_dir"

# Production secrets/config are server-owned. A code/image ship must never
# silently replace them with the packager machine's local copies. Runtime JSON
# is owner-readable/writable and group-readable by the unprivileged container
# identity (GID 10001); it is never made world-readable. Normalise legacy
# 10001:10001/0400 files before preserving them so the SSH deploy user can
# perform future ships without losing access.
deploy_uid="$(id -u)"
runtime_gid="10001"
normalize_runtime_json() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  sudo chown "${deploy_uid}:${runtime_gid}" "$path"
  sudo chmod 0640 "$path"
}

normalize_runtime_json "$install_dir/deploy/bootstrap.production.json"
normalize_runtime_json "$install_dir/deploy/webhook-secrets.production.json"

preserve_dir="$(mktemp -d)"
cleanup() { rm -rf -- "$preserve_dir"; }
trap cleanup EXIT
for rel in .crowdrelay.local.sh deploy/.env.production deploy/bootstrap.production.json deploy/webhook-secrets.production.json; do
  if [[ -f "$install_dir/$rel" ]]; then
    mkdir -p "$preserve_dir/$(dirname "$rel")"
    cp -a "$install_dir/$rel" "$preserve_dir/$rel"
  fi
done

tar -xzf "$archive" -C "$install_dir"
rm -f -- "$archive"
for rel in .crowdrelay.local.sh deploy/.env.production deploy/bootstrap.production.json deploy/webhook-secrets.production.json; do
  if [[ -f "$preserve_dir/$rel" ]]; then
    mkdir -p "$install_dir/$(dirname "$rel")"
    cp -a "$preserve_dir/$rel" "$install_dir/$rel"
  fi
done
cd "$install_dir"
chmod 700 crowdrelayctl
chmod 600 .crowdrelay.local.sh deploy/.env.production
normalize_runtime_json "$install_dir/deploy/bootstrap.production.json"
normalize_runtime_json "$install_dir/deploy/webhook-secrets.production.json"
./crowdrelayctl deploy
} </dev/null
REMOTE
}

command="${1:-}"
case "$command" in
  init)
    init_files
    ;;
  doctor)
    doctor
    ;;
  pin)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    pin_sha "$2"
    ;;
  status)
    doctor
    compose ps
    ;;
  deploy)
    deploy
    ;;
  verify)
    doctor
    verify
    ;;
  logs)
    doctor
    if [[ $# -eq 2 ]]; then
      compose logs --follow --tail=200 "$2"
    else
      compose logs --follow --tail=200
    fi
    ;;
  heartbeat)
    report_control_plane_runtime
    ;;
  resources)
    resources
    ;;
  backup)
    if declare -F crowdrelay_backup >/dev/null 2>&1; then
      crowdrelay_backup
    else
      echo "Define crowdrelay_backup() in $LOCAL_CONFIG." >&2
      exit 1
    fi
    ;;
  package)
    package_deploy "${2:-}"
    ;;
  ship)
    ship
    ;;
  rollback)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    pin_sha "$2"
    deploy
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
